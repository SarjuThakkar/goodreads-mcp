# Static bearer token Pebble must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=generate-a-random-token-here

# Persistent Chromium profile. Must be a volume -- this is the signed-in
# session, and losing it means signing in again on the touchscreen.
GOODREADS_PROFILE=/profile

# Where actions queued while signed out are kept until they can be applied.
GOODREADS_QUEUE=/profile/queue.json

# How long the headed authenticate.py window waits for a human, in seconds.
GOODREADS_AUTH_TIMEOUT=600
